# MODÈLE de paramètres de déploiement (CIBLE) d'un nouveau restaurant.
#
# Pour ajouter un restaurant :
#   cp deploy/clients/EXEMPLE.env deploy/clients/<slug>.env
# puis renseigne les valeurs ci-dessous et suis MULTI-RESTAURANT.md.
#
# Ce fichier ne contient AUCUN secret : les secrets vivent dans le .env distant.

# Adresse SSH du VPS (root@IP ou user@host).
DEPLOY_VPS="${DEPLOY_VPS:-root@VOTRE_IP_SERVEUR}"

# Dossier distant DÉDIÉ au restaurant (jamais partagé avec un autre site).
DEPLOY_REMOTE_DIR="${DEPLOY_REMOTE_DIR:-/root/<slug>}"

# URL HTTPS publique finale (après DNS + certbot).
DEPLOY_SITE_URL="${DEPLOY_SITE_URL:-https://votre-domaine.fr}"

# Projet Docker Compose DÉDIÉ (isole conteneurs + volume Postgres).
DEPLOY_COMPOSE_PROJECT="${DEPLOY_COMPOSE_PROJECT:-<slug>}"

# Port hôte local unique (127.0.0.1:PORT). Choisis un port libre et note-le
# dans deploy/clients/PORTS.md pour éviter les collisions.
APP_HOST_PORT="${APP_HOST_PORT:-32xx}"

# Clé SSH (défaut : ~/.ssh/deploy_key). Décommente pour surcharger.
# DEPLOY_KEY="$HOME/.ssh/deploy_key"
