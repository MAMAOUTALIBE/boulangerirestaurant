# Paramètres de déploiement (CIBLE) du restaurant « Anatolia Grill ».
#
# Ce fichier ne contient AUCUN secret : les secrets (mots de passe, clés Stripe,
# etc.) vivent uniquement dans le fichier .env distant, sur le VPS.
# Chargé par deploy/deploy-client.sh anatolia-grill.
#
# La forme ${VAR:-défaut} laisse un override d'environnement primer si besoin.

DEPLOY_VPS="${DEPLOY_VPS:-root@213.130.144.215}"
DEPLOY_REMOTE_DIR="${DEPLOY_REMOTE_DIR:-/root/restaurant-turc}"
DEPLOY_SITE_URL="${DEPLOY_SITE_URL:-https://lodene.cloud}"
DEPLOY_COMPOSE_PROJECT="${DEPLOY_COMPOSE_PROJECT:-restaurant-turc}"

# Port hôte local (127.0.0.1:PORT). Doit correspondre à APP_HOST_PORT du .env
# distant ET au vhost Nginx. Registre des ports : deploy/clients/PORTS.md
APP_HOST_PORT="${APP_HOST_PORT:-3201}"

# Clé SSH (défaut : ~/.ssh/deploy_key). Décommente pour surcharger.
# DEPLOY_KEY="$HOME/.ssh/deploy_key"
