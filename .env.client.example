# ─────────────────────────────────────────────────────────────────────────────
# MODÈLE .env DISTANT — un restaurant (stratégie multi-instance)
# ─────────────────────────────────────────────────────────────────────────────
# Ce fichier vit UNIQUEMENT sur le VPS, dans le dossier distant du restaurant
# (ex. /root/<slug>/.env). Il n'est JAMAIS synchronisé par rsync (exclu) ni
# commité (git ignore .env). Copier-remplir une fois par restaurant :
#
#   scp .env.client.example root@IP:/root/<slug>/.env   # puis remplir sur le VPS
#
# Variables marquées [PAR-RESTAURANT] : uniques à chaque instance.
# Tout ce qui est identité affichée (nom, contact, horaires…) se règle PLUTÔT
# dans /admin/parametres — ces valeurs ne sont ici que des secours techniques.

# ── Base de données (conteneur « db » dédié de ce projet Compose) ────────────
# [PAR-RESTAURANT] identifiants de LA base de ce restaurant (isolée par volume).
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=            # [PAR-RESTAURANT] long secret aléatoire
POSTGRES_DB=restaurant
# (DATABASE_URL est construit automatiquement par docker-compose.)

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr   # [PAR-RESTAURANT] domaine final
APP_HOST_PORT=32xx                              # [PAR-RESTAURANT] port unique (cf. deploy/clients/PORTS.md)
SESSION_SECRET=                                 # [PAR-RESTAURANT] secret aléatoire (openssl rand -hex 32)
ADMIN_EMAILS=admin@votre-domaine.fr             # [PAR-RESTAURANT] e-mail(s) admin, séparés par des virgules
ADMIN_PASSWORD=                                 # [PAR-RESTAURANT] mot de passe admin
DEFAULT_RESTAURANT_SLUG=<slug>                  # [PAR-RESTAURANT] doit correspondre au restaurant provisionné

# ── Géolocalisation (distance de livraison, SEO local) ───────────────────────
RESTAURANT_LATITUDE=48.6908     # [PAR-RESTAURANT]
RESTAURANT_LONGITUDE=2.3738     # [PAR-RESTAURANT]

# ── Commandes par WhatsApp / Telegram (repli sans paiement) ──────────────────
NEXT_PUBLIC_WHATSAPP_ORDER_NUMBER=      # [PAR-RESTAURANT] ex. +33XXXXXXXXX
NEXT_PUBLIC_TELEGRAM_ORDER_USERNAME=    # [PAR-RESTAURANT] pseudo sans @
WHATSAPP_ORDER_TO=                      # [PAR-RESTAURANT] destinataire des alertes commande
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ── Paiement Stripe (optionnel — repli « simulé » si absent) ─────────────────
# [PAR-RESTAURANT] chaque restaurant a son propre compte / ses propres clés.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_COUNTRY=FR

# ── E-mails Resend (optionnel — log console si absent) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Restaurant <contact@votre-domaine.fr>   # [PAR-RESTAURANT]

# ── SMS / WhatsApp Twilio (optionnel — log console si absent) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# ── Relance marketing (cron) ─────────────────────────────────────────────────
CRON_SECRET=            # requis pour activer /api/cron/reengage

# ── Rate-limiting distribué (Upstash Redis, optionnel) ───────────────────────
# Sans ces clés : repli mémoire par instance (OK en mono-conteneur).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
