// Schéma Prisma — base PostgreSQL pour restaurant de spécialités africaines.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        String   @id @default(cuid())
  reference String   @unique
  createdAt DateTime @default(now())
  // Statut : en attente | payée | en préparation | prête | livrée | annulée
  status    String   @default("en attente")

  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?
  customerNotes   String?

  subtotal      Float        @default(0)
  discount      Float        @default(0)
  promoCode     String?
  /// Mode : livraison | emporter | surplace
  fulfillment   String       @default("emporter")
  deliveryFee   Float        @default(0)
  tip           Float        @default(0)
  /// Créneau souhaité (null = dès que possible)
  scheduledAt   DateTime?
  /// Temps de préparation estimé (minutes)
  prepTimeMin   Int          @default(20)
  total         Float
  /// Points de fidélité déjà attribués pour cette commande (idempotence).
  pointsAwarded Boolean      @default(false)
  restaurant    Restaurant?  @relation(fields: [restaurantId], references: [id])
  restaurantId  String?
  driver        Driver?      @relation(fields: [driverId], references: [id])
  driverId      String?
  items         OrderLine[]
  events        OrderEvent[]

  @@index([customerEmail])
  @@index([restaurantId])
}

/// Restaurant géré sur la plateforme (multi-établissement).
model Restaurant {
  id                       String    @id @default(cuid())
  slug                     String    @unique
  name                     String
  active                   Boolean   @default(true)
  stripeAccountId          String?   @unique
  stripeOnboardingComplete Boolean   @default(false)
  stripeChargesEnabled     Boolean   @default(false)
  stripePayoutsEnabled     Boolean   @default(false)
  stripeDetailsSubmitted   Boolean   @default(false)
  stripeLastSyncedAt       DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  orders                   Order[]
}

/// Livreur « maison ».
model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

/// Journal d'audit des changements de statut d'une commande.
model OrderEvent {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String
  actor     String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Code promotionnel géré en base.
model PromoCode {
  id         String    @id @default(cuid())
  code       String    @unique
  /// "percent" (ex: 10 = -10%) ou "fixed" (ex: 5 = -5€)
  type       String    @default("percent")
  value      Float
  active     Boolean   @default(true)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model OrderLine {
  id       String  @id @default(cuid())
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  String
  dishId   String
  name     String
  /// Prix unitaire (base + options).
  price    Float
  quantity Int
  /// Options choisies : [{ label, priceDelta }]
  options  Json?
  /// Instructions spéciales du client.
  note     String?
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Coordonnées captées lors des tests/démos du site.
model DemoLead {
  id         String   @id @default(cuid())
  source     String
  sourceId   String?
  name       String?
  email      String?
  phone      String?
  message    String?
  visits     Int      @default(1)
  converted  Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([source])
  @@index([lastSeenAt])
}

/// Catégorie de menu (Entrées, Plats, Desserts, Boissons…).
model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  /// Accroche affichée sous le titre de la catégorie (optionnelle).
  description String?
  /// Bannière de la catégorie, choisie dans la médiathèque (optionnelle).
  image       String?
  /// Masquer une catégorie sans supprimer ses plats.
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  dishes      Dish[]
}

/// Plat du menu (éditable depuis le back-office).
model Dish {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String
  price        Float
  image        String
  tag          String?
  available    Boolean       @default(true)
  /// Mis en avant : spécialités de l'accueil et badge « Populaire » sur la carte.
  /// Remplace les listes de slugs qui étaient codées en dur dans les composants.
  featured     Boolean       @default(false)
  /// Stock du jour (null = illimité). Limite les ventes et affiche « épuisé ».
  dailyStock   Int?
  /// Unités déjà vendues pour la date `stockDate` (compteur quotidien).
  soldToday    Int           @default(0)
  /// Date (AAAA-MM-JJ) à laquelle se rapporte `soldToday` (reset paresseux).
  stockDate    String?
  sortOrder    Int           @default(0)
  /// Temps de préparation estimé du plat (minutes) — sert au calcul d'ETA.
  prepMinutes  Int           @default(15)
  category     Category?     @relation(fields: [categoryId], references: [id])
  categoryId   String?
  optionGroups OptionGroup[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Groupe d'options d'un plat (ex: « Accompagnement », « Suppléments »).
model OptionGroup {
  id        String   @id @default(cuid())
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dishId    String
  name      String
  /// "single" (choisir 1) ou "multi" (choisir plusieurs)
  type      String   @default("single")
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  options   Option[]

  @@index([dishId])
}

/// Une option dans un groupe (avec éventuel surcoût).
model Option {
  id         String      @id @default(cuid())
  group      OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId    String
  name       String
  priceDelta Float       @default(0)
  sortOrder  Int         @default(0)

  @@index([groupId])
}

/// Panier suivi côté serveur (pour le funnel de conversion et la relance).
model AbandonedCart {
  id        String   @id @default(cuid())
  cartId    String   @unique
  email     String?
  name      String?
  phone     String?
  items     Json
  itemCount Int      @default(0)
  total     Float    @default(0)
  /// actif | converti | relancé
  status    String   @default("actif")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
}

/// Avis client (modéré avant publication).
model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}

/// Horaires d'ouverture par jour (0 = dimanche … 6 = samedi).
model OpeningHour {
  id           Int     @id @default(autoincrement())
  dayOfWeek    Int     @unique
  closed       Boolean @default(false)
  /// Minutes depuis minuit (ex: 660 = 11h00, 1380 = 23h00).
  openMinutes  Int     @default(660)
  closeMinutes Int     @default(1380)
}

/// Réglages de prise de commande (singleton, id = "default").
model OrderingSetting {
  id              String @id @default("default")
  /// vitrine | paiement_sur_place | paiement_en_ligne. Fermé par défaut.
  orderingMode    String @default("vitrine")
  /// Palette d'accent publique : ambre | terracotta | emeraude.
  colorPalette    String @default("ambre")
  slotIntervalMin Int    @default(15)
  leadTimeMin     Int    @default(20)
  capacityPerSlot Int    @default(8)
  /// Alerte « imminent » : minutes avant l'échéance.
  imminentMin     Int    @default(5)
  /// Stagnation max en « en préparation » (minutes).
  prepMaxMin      Int    @default(10)
  /// Stagnation max dans les autres colonnes (minutes).
  stageMaxMin     Int    @default(5)
}

/// Identité du restaurant éditable depuis /admin/parametres (singleton « default »).
/// Tous les champs sont optionnels : vide → on retombe sur `defaultSiteConfig`
/// (src/lib/config.ts). Permet de rebrander le site sans toucher au code.
model SiteSetting {
  id               String  @id @default("default")
  name             String?
  shortName        String?
  description      String?
  phone            String?
  email            String?
  address          String?
  /// Ville affichée (zone de livraison, retrait, SEO local). Ex. « Bagnolet ».
  city             String?
  facebook         String?
  instagram        String?
  tiktok           String?
  /// Numéro WhatsApp des commandes (aussi utilisé pour le lien wa.me).
  whatsappNumber   String?
  /// Pseudo Telegram des commandes (aussi utilisé pour le lien t.me).
  telegramUsername String?
  /// Résumé des horaires affiché (ex. « Lun – Dim : 11h30 – 23h00 »).
  hoursSummary     String?

  // ── Image de marque (choisie dans la médiathèque) ──────────────────────────
  /// Logo affiché dans l'en-tête et le pied de page.
  logoUrl                String?
  /// Favicon (onglet du navigateur).
  faviconUrl             String?
  /// Image de partage sur les réseaux (Open Graph / Twitter).
  ogImageUrl             String?
  /// Accroche courte affichée sous le nom.
  tagline                String?
  /// Titre affiché dans le hero d'accueil (vide → nom du restaurant).
  heroTitle              String?
  /// Description affichée sous le titre du hero.
  heroDescription        String?
  /// Permet à l'administrateur de masquer le titre sans le supprimer.
  heroTitleVisible       Boolean @default(true)
  /// Permet à l'administrateur de masquer la description sans la supprimer.
  heroDescriptionVisible Boolean @default(true)

  // ── Référencement ──────────────────────────────────────────────────────────
  /// Titre de la page d'accueil (défaut : « <nom> | <description> »).
  metaTitle       String?
  /// Description pour les moteurs de recherche et les partages.
  metaDescription String?
  /// Mots-clés séparés par des virgules.
  keywords        String?

  // ── Mentions légales ───────────────────────────────────────────────────────
  legalCompany  String?
  legalStatus   String?
  legalCapital  String?
  legalSiren    String?
  legalSiret    String?
  legalApe      String?
  legalVat      String?
  legalDirector String?
  legalHost     String?

  /// Couleur d'accent personnalisée (hex), utilisée si la palette vaut « perso ».
  accentColor String?

  updatedAt DateTime @default(now()) @updatedAt
}

/// Zone de livraison : frais et minimum de commande par code postal.
model DeliveryZone {
  id         String @id @default(cuid())
  postalCode String @unique
  fee        Float  @default(0)
  minOrder   Float  @default(0)
}

/// Fiche client consolidée (CRM), clé = email.
model Customer {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  /// Date d'anniversaire utilisée uniquement pour les relances consenties.
  birthDate     DateTime?
  /// Notes internes (allergies, préférences, incidents…).
  notes         String    @default("")
  /// Étiquettes de segmentation (VIP, habitué, à relancer…).
  tags          String[]  @default([])
  /// Points de fidélité cumulés.
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Règle de relance automatique configurable depuis le CRM.
model MarketingRule {
  id          String              @id
  name        String
  type        String
  enabled     Boolean             @default(false)
  subject     String
  body        String
  promoCode   String?
  delayDays   Int?
  weekday     Int?
  weatherKind String?
  lastRunAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  campaigns   MarketingCampaign[]

  @@index([enabled])
  @@index([type])
}

/// Exécution manuelle ou automatique d'une campagne marketing.
model MarketingCampaign {
  id             String              @id @default(cuid())
  rule           MarketingRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleId         String?
  name           String
  type           String
  subject        String
  promoCode      String?
  recipientCount Int                 @default(0)
  sentAt         DateTime            @default(now())
  createdAt      DateTime            @default(now())
  dispatches     MarketingDispatch[]

  @@index([ruleId])
  @@index([sentAt])
  @@index([promoCode])
}

/// Envoi individuel, dédupliqué, permettant de mesurer la conversion.
model MarketingDispatch {
  id         String            @id @default(cuid())
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  email      String
  status     String            @default("envoyé")
  dedupeKey  String            @unique
  sentAt     DateTime          @default(now())

  @@index([campaignId])
  @@index([email])
  @@index([sentAt])
}

/// Réservation de table.
model Reservation {
  id        String   @id @default(cuid())
  reference String   @unique
  createdAt DateTime @default(now())
  status    String   @default("en attente") // en attente | confirmée | annulée

  name   String
  email  String
  phone  String
  date   String // jour souhaité (AAAA-MM-JJ)
  time   String // créneau souhaité (HH:MM)
  guests Int
  notes  String?

  @@index([email])
}

/// Demande de devis traiteur / événementiel.
model CateringRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  status    String   @default("nouveau") // nouveau | traité

  name      String
  email     String
  phone     String
  eventDate String?
  guests    Int
  message   String

  @@index([email])
}

/// Demande de devis sur-mesure.
model CustomRequest {
  id        String   @id @default(cuid())
  reference String   @unique
  createdAt DateTime @default(now())
  /// nouveau | devis envoyé | confirmé | prêt | récupéré | annulé
  status    String   @default("nouveau")

  name           String
  email          String
  phone          String
  occasion       String
  servings       Int
  preferences    String  @map("flavor")
  message        String? @map("messageOnCake")
  pickupDate     String
  pickupTime     String?
  inspirationUrl String?
  budget         String?
  allergies      String?
  details        String

  @@index([email])
  @@map("CustomCakeRequest")
}

/// Produit de saison vendu sur précommande (galette, bûche, pièce de fête…).
model SeasonalProduct {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String
  image       String
  price       Float
  /// Fenêtre de vente des précommandes.
  salesStart  DateTime
  salesEnd    DateTime
  /// Fenêtre de retrait possible (dates AAAA-MM-JJ incluses).
  pickupStart String
  pickupEnd   String
  /// Quota total de précommandes et compteur déjà réservé.
  quota       Int
  sold        Int                @default(0)
  active      Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  preorders   SeasonalPreorder[]

  @@index([active])
}

/// Précommande d'un produit de saison (paiement au retrait).
model SeasonalPreorder {
  id         String          @id @default(cuid())
  reference  String          @unique
  createdAt  DateTime        @default(now())
  /// réservé | confirmé | prêt | récupéré | annulé
  status     String          @default("réservé")
  product    SeasonalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  quantity   Int
  name       String
  email      String
  phone      String
  pickupDate String
  notes      String?
  paid       Boolean         @default(false)

  @@index([productId])
  @@index([email])
}

/// Offre anti-gaspi du jour (paniers surprise à prix réduit).
model AntiWasteOffer {
  id            String                 @id @default(cuid())
  /// Jour de l'offre (AAAA-MM-JJ) — une offre par jour.
  date          String                 @unique
  title         String                 @default("Panier surprise")
  description   String                 @default("")
  price         Float
  originalValue Float?
  quantity      Int
  sold          Int                    @default(0)
  pickupStart   String                 @default("18:00")
  pickupEnd     String                 @default("19:30")
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  reservations  AntiWasteReservation[]

  @@index([active])
}

/// Réservation d'un panier anti-gaspi (paiement au retrait).
model AntiWasteReservation {
  id        String         @id @default(cuid())
  reference String         @unique
  createdAt DateTime       @default(now())
  /// réservé | récupéré | annulé
  status    String         @default("réservé")
  offer     AntiWasteOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId   String
  quantity  Int
  name      String
  email     String
  phone     String
  paid      Boolean        @default(false)

  @@index([offerId])
  @@index([email])
}

/// Jeton à usage unique pour la connexion par lien magique (magic link).
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// Déduplication des webhooks Stripe : l'`id` (= event.id Stripe) sert de clé
/// d'idempotence pour garantir un traitement au plus une fois (anti-rejeu/race).
model ProcessedStripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Bloc de contenu éditorial, éditable depuis /admin/contenus.
///
/// Modèle volontairement générique : une ligne = un élément d'une section
/// (une diapositive du hero, une photo de la galerie, une étape de commande,
/// une colonne du footer, une page légale…). `section` désigne l'emplacement,
/// `key` identifie le bloc de façon stable à l'intérieur de la section.
///
/// Les valeurs par défaut vivent dans le code (`DEFAULT_CONTENT_BLOCKS`,
/// src/lib/content-blocks.ts) : la base ne contient que ce qui a été
/// personnalisé, et un site dont la table est vide s'affiche normalement.
model ContentBlock {
  id        String   @id @default(cuid())
  /// Emplacement (ex. « hero », « galerie », « page-cgv »).
  section   String
  /// Identifiant stable du bloc dans sa section.
  key       String
  sortOrder Int      @default(0)
  /// Masquer un bloc sans le supprimer.
  active    Boolean  @default(true)
  title     String?
  subtitle  String?
  /// Corps en Markdown (rendu par `renderMarkdown`, jamais du HTML brut).
  body      String?
  /// Média principal (chemin `/media/…` ou `/images/…`).
  mediaUrl  String?
  /// Vignette d'une vidéo.
  posterUrl String?
  /// Texte alternatif du média.
  alt       String?
  href      String?
  ctaLabel  String?
  /// Nom d'icône lucide, restreint à une liste blanche côté rendu.
  icon      String?
  /// Champs spécifiques à une section (durée d'une diapositive, tag…).
  data      Json?
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([section, key])
  @@index([section])
}

/// Médiathèque du CRM : toute image/vidéo utilisable depuis /admin.
///
/// Deux origines (`source`) :
///  - `"upload"`   : fichier téléversé depuis /admin/medias. Stocké hors de
///                   `public/` (voir `src/lib/media.ts`) et servi par la route
///                   `/media/[...path]` ; supprimable depuis le CRM.
///  - `"template"` : fichier livré avec le dépôt (`public/images`,
///                   `public/videos`), indexé au seed pour être choisissable.
///                   NON supprimable depuis le CRM (il reviendrait au déploiement).
model Media {
  id        String   @id @default(cuid())
  /// Chemin public servant de référence partout (`/media/…` ou `/images/…`).
  url       String   @unique
  filename  String
  mimeType  String
  /// Taille en octets.
  size      Int      @default(0)
  width     Int?
  height    Int?
  /// Texte alternatif (accessibilité + SEO).
  alt       String?
  /// Classement libre pour filtrer la médiathèque (« plats », « galerie »…).
  folder    String?
  /// "upload" | "template"
  source    String   @default("upload")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([source])
  @@index([folder])
}
