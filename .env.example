# Base de données PostgreSQL (requis) — utilisée par Prisma
DATABASE_URL="postgresql://restaurant_turc:restaurant_turc@localhost:5440/restaurant_turc?schema=public"

# URL publique du site (utilisée pour SEO, QR code, liens de paiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret de signature des cookies de session (générer une valeur aléatoire en prod)
SESSION_SECRET=change-me-en-production

# Emails autorisés au back-office /admin (séparés par des virgules)
ADMIN_EMAILS=admin@anatolia-grill.fr
ADMIN_PASSWORD=AdminTest2026!
# Restaurant par défaut utilisé pour les nouvelles commandes (slug DB)
DEFAULT_RESTAURANT_SLUG=anatolia-grill

# Paiement Stripe (optionnel) — si absent : mode simulation
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (obtenu via `stripe listen` ou le dashboard)
STRIPE_WEBHOOK_SECRET=
# Pays des comptes Stripe Connect créés depuis l'admin
STRIPE_CONNECT_COUNTRY=FR

# Emails transactionnels via Resend (optionnel) — si absent : log console
RESEND_API_KEY=
EMAIL_FROM="Anatolia Grill <onboarding@resend.dev>"

# SMS / WhatsApp via Twilio (optionnel) — si absent : log console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+33000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Commandes par messagerie
# Public : liens client préremplis WhatsApp / Telegram.
NEXT_PUBLIC_WHATSAPP_ORDER_NUMBER=+33775787825
NEXT_PUBLIC_TELEGRAM_ORDER_USERNAME=anatoliagrill
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com
NEXT_PUBLIC_TELEGRAM_URL=
# Privé : notifications restaurant à chaque commande.
WHATSAPP_ORDER_TO=+33775787825
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# Relance automatique des inactifs (cron Vercel) — secret de protection
CRON_SECRET=change-me

# Rate-limiting distribué Upstash Redis (recommandé en production)
# Si absent, fallback local en mémoire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Assistant IA (chatbot) — fournisseur compatible OpenAI.
# Si ASSISTANT_API_KEY est absent : l'assistant répond en mode "règles" (mots-clés).
# Modèle gratuit recommandé : Groq + Llama 3.3 70B (clé gratuite sur https://console.groq.com/keys)
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_MODEL=llama-3.3-70b-versatile
