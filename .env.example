# Base de données PostgreSQL (requis) — utilisée par Prisma
DATABASE_URL="postgresql://restaurant_turc:restaurant_turc@localhost:5440/restaurant_turc?schema=public"

# URL publique du site (utilisée pour SEO, QR code, liens de paiement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret de signature des cookies de session — REQUIS en production (l'app refuse
# de démarrer sinon). Générer une valeur aléatoire forte, ex :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-en-production

# Emails autorisés au back-office /admin (séparés par des virgules)
ADMIN_EMAILS=admin@example.com
# Mot de passe admin — REQUIS pour accéder à /admin (le lien magique seul ne
# suffit plus). Utiliser une valeur longue et aléatoire.
# RECOMMANDÉ : fournir plutôt ADMIN_PASSWORD_HASH (le mot de passe en clair ne
# vit alors pas dans l'environnement). Générer le hash :
#   node -e "const c=require('crypto');const s=c.randomBytes(16);process.stdout.write('scrypt$'+s.toString('hex')+'$'+c.scryptSync(process.argv[1],s,32).toString('hex'))" "MON_MOT_DE_PASSE"
ADMIN_PASSWORD=change-me-with-a-long-random-password
# ADMIN_PASSWORD_HASH=scrypt$<selHex>$<hashHex>
# Restaurant par défaut utilisé pour les nouvelles commandes (slug DB)
DEFAULT_RESTAURANT_SLUG=anatolia-grill

# Dossier des médias téléversés depuis /admin/medias.
# Par défaut « .data/uploads », relatif au dossier de lancement (racine du projet
# en local, /app dans Docker où le volume « uploads » est monté). À renseigner en
# ABSOLU seulement si le serveur est lancé depuis un autre répertoire.
# MEDIA_DIR=/var/lib/restaurant/uploads

# Paiement Stripe (optionnel) — si absent : mode simulation
STRIPE_SECRET_KEY=
# Secret du webhook Stripe (obtenu via `stripe listen` ou le dashboard)
STRIPE_WEBHOOK_SECRET=
# Pays des comptes Stripe Connect créés depuis l'admin
STRIPE_CONNECT_COUNTRY=FR

# Emails transactionnels via Resend (optionnel) — si absent : log console
RESEND_API_KEY=
EMAIL_FROM="Anatolia Grill <contact@lodene.org>"
# Coordonnées utilisées pour les offres météo (Juvisy-sur-Orge par défaut)
RESTAURANT_LATITUDE=48.6908
RESTAURANT_LONGITUDE=2.3738

# SMS / WhatsApp via Twilio (optionnel) — si absent : log console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+33000000000
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Commandes par messagerie
# Public : liens client préremplis WhatsApp / Telegram.
NEXT_PUBLIC_WHATSAPP_ORDER_NUMBER=+33775787825
NEXT_PUBLIC_TELEGRAM_ORDER_USERNAME=anatoliagrill
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com
NEXT_PUBLIC_TELEGRAM_URL=
# Privé : notifications restaurant à chaque commande.
WHATSAPP_ORDER_TO=+33775787825
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=

# Relance automatique des inactifs (cron Vercel) — secret de protection.
# Envoyé via l'en-tête `Authorization: Bearer <secret>` UNIQUEMENT (plus en query).
# Générer une valeur aléatoire forte (cf. SESSION_SECRET).
CRON_SECRET=change-me

# Rate-limiting distribué Upstash Redis (recommandé en production multi-instances).
# Si absent, fallback local en mémoire (OK pour un VPS mono-instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nombre de proxies de confiance en frontal (Nginx = 1 ; 2 si un CDN précède
# Nginx). Sert à extraire l'IP réelle depuis X-Forwarded-For pour le rate-limit
# sans se laisser tromper par un en-tête falsifié. Défaut : 1.
TRUSTED_PROXY_COUNT=1

# Assistant IA (chatbot) — fournisseur compatible OpenAI.
# Si ASSISTANT_API_KEY est absent : l'assistant répond en mode "règles" (mots-clés).
# Modèle gratuit recommandé : Groq + Llama 3.3 70B (clé gratuite sur https://console.groq.com/keys)
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_MODEL=llama-3.3-70b-versatile
